# Environment configuration
NODE_ENV=development
APP_BASE_URL=http://cads-mis:3000

# OIDC authentication
OIDC_CLIENT_ID=jt-ci-cads-mis
OIDC_CLIENT_SECRET=jt-ci-mock-secret
OIDC_ENABLE_DEBUG_ENDPOINTS=true

OIDC_REDIRECT_URI=http://cads-mis:3000/auth/callback
OIDC_POST_LOGOUT_REDIRECT_URI=http://cads-mis:3000/auth/signed-out
OIDC_POST_LOGIN_REDIRECT_URI=/dashboard

## Internal endpoints (server OIDC mock)
OIDC_WELL_KNOWN_URL=http://cads-oidc-mock/.well-known/openid-configuration

## External endpoint (browser OIDC mock)
OIDC_AUTHORIZATION_ENDPOINT=http://cads-oidc-mock/connect/authorize
OIDC_END_SESSION_ENDPOINT=http://cads-oidc-mock/connect/endsession

## Resource: CADS CDS
AZURE_CLIENT_CADS_CDS_ID=local-cads-cds
USE_SIMPLE_SCOPES=true

# Session configuration
SESSION_CACHE_ENGINE=redis
SESSION_COOKIE_PASSWORD=3f9c1e8b7d2a4f6c9b1e3d7f2a8c4e6b

# Redis configuration
REDIS_HOST=cads-redis
REDIS_PORT=6379
REDIS_USERNAME=default
REDIS_PASSWORD=3f9c1e8b7d2a4f6c9b1e3d7f2a8c4e6b
REDIS_KEY_PREFIX=jt-ci-cads-mis
USE_SINGLE_INSTANCE_CACHE=true
REDIS_TLS=false

# CADS CDS: Backend
CADS_BACKEND_URL=http://cads_cds:5555